{
  "version": 3,
  "port": 8000,
  "timeout": "10s",
  "name": "Paybridge API Gateway",
  "endpoints": [
    {
      "endpoint": "/api/v1/register",
      "method": "POST",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/auth/register",
          "method": "POST",
          "host": ["http://paybridge-user-svc:8080"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/api/v1/login",
      "method": "POST",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/auth/login",
          "method": "POST",
          "host": ["http://paybridge-user-svc:8080"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/v1/loan-applications/{id}/approve",
      "method": "POST",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/loan-applications/{id}/approve",
          "method": "POST",
          "host": ["http://paybridge-loan-svc:8084"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/v1/loan-applications",
      "method": "POST",
      "extra_config": {
        "auth/validator": {
          "alg": "HS256",
          "secret": "a3f9c7e12b5d4f9083e2c1a7d9b8f6c4a1e0d3f2b4c59687e0b1c4d2f9a7b3c1",
          "roles_key": "roles",
          "roles": ["ROLE_USER"],
          "propagate_claims": ["user_id", "roles"]
        }
      },
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/loan-applications",
          "method": "POST",
          "host": ["http://paybridge-loan-svc:8084"],
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/v1/account/balance/{owner_id}",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/internal/account/{owner_id}/balance",
          "method": "GET",
          "host": ["http://paybridge-transaction-svc-dev:8082"],
          "encoding": "no-op",
          "extra_config": {
            "backend/http": {
              "return_error_details": "backend_alias"
            },
            "modifier/martian": {
              "header.Modifier": {
                "scope": ["request"],
                "name": "Authorization",
                "value": "Bearer c9d44f1802afef391a0c847fb3bf6967c77a9f0f0ac12c29dfe651eac9442c52"
              }
            }
          }
        }
      ]
    }
  ],
  "extra_config": {
    "security/cors": {
      "allow_origins": ["*"],
      "allow_methods": ["GET", "POST", "PUT", "DELETE"],
      "allow_headers": ["Origin", "Authorization", "Content-Type", "x-trace-id"]
    }
  }
}